generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
  CARRIER_MAIN
  CARRIER_SUB
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  DISABLED
}

enum DriverStatus {
  PENDING
  ACTIVE
  REJECTED
  DISABLED
}

enum VehicleType {
  TON_1_5
  TON_3_5
  TON_7
  TON_10
  OTHER
}

enum OrderStatus {
  PENDING_REVIEW
  BIDDING
  MATCHED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
  OPEN
  LOCKED
  PENDING_CONFIRM
  PENDING_AUDIT
  PENDING_EXECUTION
  FAILED
}

enum MatchPath {
  A
  B
  C
}

enum CargoType {
  GENERAL
  DANGEROUS
  OTHER
}

enum PackagingType {
  CARTON
  WOOD
  PALLET
  NAKED
  BAG
  OTHER
}

enum NegotiationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum CapacityStatus {
  OPEN
  MATCHED
  CLOSED
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(PENDING)
  displayName  String?
  phone        String?
  email        String?
  rejectReason String?
  locale       String     @default("zh")
  carrierKind  String?
  parentUserId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company       Company?
  carrierProfile CarrierProfile?
  parent        User?  @relation("CarrierTeam", fields: [parentUserId], references: [id])
  children      User[] @relation("CarrierTeam")
  orders        Order[]  @relation("CustomerOrders")
  acceptedOrders Order[] @relation("AcceptedBy")
  assignedOrders Order[] @relation("AssignedTo")
  carrierBids   CarrierBid[]
  vehicles      Vehicle[] @relation("VehicleOwner")
  capacities    Capacity[]
  negotiations  CapacityNegotiation[]
  notifications Notification[]
  savedAddresses SavedAddress[]

  @@index([role, status])
  @@index([phone])
  @@index([parentUserId])
}

model SavedAddress {
  id        String   @id @default(cuid())
  userId    String
  label     String
  province  String
  ward      String
  address   String
  contact   String
  phone     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Company {
  id            String   @id @default(cuid())
  userId        String   @unique
  companyName   String
  taxCode       String?
  contactName   String?
  contactPhone  String?
  address       String?
  licenseImage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Driver {
  id            String       @id @default(cuid())
  name          String
  phone         String
  vehicleType   VehicleType
  plateNumber   String?
  idNumber      String?
  notes         String?
  status        DriverStatus @default(PENDING)
  rejectReason  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  bids          OrderBid[]
  matchedOrders Order[]      @relation("MatchedDriver")

  @@index([status])
  @@index([phone])
}

model Order {
  id                String      @id @default(cuid())
  orderNo           String      @unique
  customerId        String
  status            OrderStatus @default(PENDING_REVIEW)

  pickupAddress     String
  pickupContact     String
  pickupPhone       String
  pickupNote        String?
  pickupAt          DateTime

  deliveryAddress   String
  deliveryContact   String
  deliveryPhone     String

  cargoName         String
  cargoWeightKg     Float
  cargoVolumeM3     Float
  vehicleType       VehicleType?
  matchPath         MatchPath?
  cargoType         CargoType?
  packaging         PackagingType?
  originProvince    String?
  originCity        String?
  originAddress     String?
  originLat         Float?
  originLng         Float?
  destProvince      String?
  destCity          String?
  destAddress       String?
  destLat           Float?
  destLng           Float?
  weightTons        Float?
  etaAt             DateTime?
  targetPriceVnd    BigInt?
  abnormalNote      String?
  commissionBps     Int?
  waitDeadline      DateTime?
  confirmDeadline   DateTime?
  auditDeadline     DateTime?
  extendCount       Int         @default(0)
  publishRound      Int         @default(1)

  customerBidVnd    BigInt?
  bidDeadline       DateTime?

  matchedDriverId   String?
  acceptedByUserId  String?
  assignedToUserId  String?
  capacityId        String?
  dealPriceVnd      BigInt?
  platformFeeVnd    BigInt?
  driverIncomeVnd   BigInt?

  adminNote         String?
  rejectReason      String?
  notifyNote        String?
  trackShareOn      Boolean     @default(false)
  driverStage       String?
  /// JSON string[] — 司机「已提货」装车照片（data URL 或 http）
  pickupPhotos      String?
  /// JSON string[] — 司机「已送达」卸车完成照片
  deliveryPhotos    String?
  routeDistanceKm   Float?
  routeDurationMin  Int?
  routeSource       String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer      User           @relation("CustomerOrders", fields: [customerId], references: [id])
  matchedDriver Driver?        @relation("MatchedDriver", fields: [matchedDriverId], references: [id])
  acceptedBy    User?          @relation("AcceptedBy", fields: [acceptedByUserId], references: [id])
  assignedTo    User?          @relation("AssignedTo", fields: [assignedToUserId], references: [id])
  bids          OrderBid[]
  carrierBids   CarrierBid[]
  cargoItems    OrderCargoItem[]
  statusLogs    OrderStatusLog[]
  trackPoints   OrderTrackPoint[]

  @@index([customerId, status])
  @@index([status, createdAt])
}

model OrderTrackPoint {
  id         String   @id @default(cuid())
  orderId    String
  lat        Float
  lng        Float
  speedKmh   Float?
  statusText String
  recordedAt DateTime
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, recordedAt])
}

model OrderBid {
  id          String   @id @default(cuid())
  orderId     String
  driverId    String
  priceVnd    BigInt
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([orderId, driverId])
  @@index([orderId])
}

model OrderStatusLog {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  operatorId String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderCargoItem {
  id        String  @id @default(cuid())
  orderId   String
  lengthCm  Float
  widthCm   Float
  heightCm  Float
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CarrierBid {
  id           String   @id @default(cuid())
  orderId      String
  publishRound Int
  bidderUserId String
  priceVnd     BigInt
  createdAt    DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bidder User  @relation(fields: [bidderUserId], references: [id])

  @@unique([orderId, publishRound, bidderUserId])
  @@index([orderId])
}

model CarrierProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  companyName     String?
  address         String?
  licenseNo       String?
  contactName     String?
  contactPhone    String?
  idNumber        String?
  driverLicense   String?
  vehicleLicense  String?
  insuranceNote   String?
  photoUrls       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id             String      @id @default(cuid())
  ownerUserId    String
  plateNumber    String
  vehicleType    VehicleType
  loadTons       Float
  assignedUserId String?
  notes          String?
  createdAt      DateTime    @default(now())
  owner          User        @relation("VehicleOwner", fields: [ownerUserId], references: [id])

  @@index([ownerUserId])
}

model Capacity {
  id               String         @id @default(cuid())
  publisherUserId  String
  location         String
  availableFrom    DateTime
  availableTo      DateTime
  destPreference   String?
  locationLat      Float?
  locationLng      Float?
  destLat          Float?
  destLng          Float?
  vehicleType      VehicleType
  loadTons         Float
  cargoTypes       String
  airportOk        Boolean
  portOk           Boolean
  expectedPriceVnd BigInt
  note             String?
  status           CapacityStatus @default(OPEN)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  publisher     User                   @relation(fields: [publisherUserId], references: [id])
  negotiations  CapacityNegotiation[]

  @@index([status])
}

model CapacityNegotiation {
  id              String             @id @default(cuid())
  capacityId      String
  customerId      String
  priceVnd        BigInt
  status          NegotiationStatus  @default(PENDING)
  originProvince  String
  originCity      String
  originAddress   String
  originContact   String
  originPhone     String
  destProvince    String
  destCity        String
  destAddress     String
  destContact     String
  destPhone       String
  cargoType       CargoType
  packaging       PackagingType
  weightTons      Float
  pickupAt        DateTime
  etaAt           DateTime
  note            String?
  respondDeadline DateTime?
  orderId         String?
  createdAt       DateTime           @default(now())

  capacity Capacity @relation(fields: [capacityId], references: [id], onDelete: Cascade)
  customer User     @relation(fields: [customerId], references: [id])

  @@index([capacityId])
  @@index([customerId])
}

model MatchSuggestion {
  id         String    @id @default(cuid())
  orderId    String
  capacityId String
  distanceKm Float
  basis      String
  score      Int       @default(0)
  reason     String?
  status     String    @default("PENDING")
  deadline   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([orderId, capacityId])
  @@index([orderId, status])
  @@index([capacityId, status])
  @@index([deadline, status])
}

model SystemConfig {
  id                 String   @id @default("default")
  commissionBps      Int      @default(2000)
  confirmTimerStart  String   @default("AFTER_BID_DEADLINE")
  confirmMinutes     Int      @default(30)
  waitMatchHours     Int      @default(24)
  extendHours        Int      @default(24)
  maxExtends         Int      @default(1)
  auditMinutes       Int      @default(30)
  bidLeadHours       Int      @default(4)
  negotiateMinutes   Int      @default(30)
  updatedAt          DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model OperationLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Translation {
  id        String   @id @default(cuid())
  key       String   @unique
  zh        String
  vi        String
  groupName String   @default("common")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([groupName])
}
